# ---------------------------------------------------------------------
# SIGNA · variables de entorno
# Copiá este archivo como .env y completá los valores.
# ---------------------------------------------------------------------

# Base PostgreSQL. En desarrollo puede ser local; en producción, Railway o Neon.
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/signa_dev?schema=public"

# Secreto para firmar el JWT de sesión. Generalo con: openssl rand -base64 48
AUTH_SECRET="cambiame-por-un-secreto-largo-y-aleatorio"

# Sistema base de la empresa: mock | sorby | lebane
SISTEMA_BASE="mock"

# URL pública de la app (se usa en los QR de las herramientas y en los enlaces de alertas)
APP_URL="http://localhost:3000"

# Con true: franja de demostración, lista de usuarios en el login
# y ruta para reiniciar los datos de ejemplo. En producción, false.
MODO_DEMO="true"

# Token que protege /api/sync y /api/alertas/evaluar.
# Vercel Cron lo manda como "Authorization: Bearer <CRON_SECRET>".
# Generalo con: openssl rand -hex 32
CRON_SECRET=""

# --- Sorby (solo con SISTEMA_BASE=sorby) ---------------------------------
# La planilla de Google Sheets que Sorby sincroniza, y una cuenta de
# servicio de Google con permiso de lectura sobre ella.
SORBY_SHEET_ID=""
SORBY_SERVICE_ACCOUNT_EMAIL=""
SORBY_SERVICE_ACCOUNT_KEY=""

# --- Lebane (solo con SISTEMA_BASE=lebane) -------------------------------
# Por API:
LEBANE_API_URL=""
LEBANE_API_TOKEN=""
# O por archivo exportado:
LEBANE_ARCHIVO=""
